// property: the default FP mode is strict IEEE-754 — 0.1 + 0.2 does NOT
// equal 0.3, and exact dyadic arithmetic is exact, under every build mode.
fn main() {
    let mut ok: i64 = 0;
    let x: f64 = 0.1;
    let y: f64 = 0.2;
    let z: f64 = x + y;
    if (z != 0.3) { ok = ok + 1; }
    let w: f64 = (1.0 + 2.0) * 3.0;
    if (w == 9.0) { ok = ok + 1; }
    let h: f64 = 0.25;
    let mut s: f64 = 0.0;
    for (i in 0..100) { s = s + h; }
    if (s == 25.0) { ok = ok + 1; }                // exact dyadic chain
    if (ok == 3) { print("ALL OK"); } else { print("FAILED"); }
    println();
}
