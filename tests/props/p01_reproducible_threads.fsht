// property: a @reproducible reduction is bitwise identical for ANY worker
// count. The data is deliberately grouping-sensitive (1e9 + 1e-7 terms):
// an unflagged parfor diverges on it; the flagged one cannot. The runner
// executes this program with FRT_THREADS=1,2,4,8 and compares outputs.
fn main() {
    let n: usize = 100000;
    let d: *f64 = malloc(f64, n);
    parfor (i in 0..n) {
        if (i < 50000) { d[i] = 1000000000.0; }
        else { d[i] = 0.0000001; }
    }
    let mut acc: f64 = 0.0;
    @reproducible parfor (i in 0..n) [reduction(+: acc)] {
        acc = acc + d[i];
    }
    print_f64(acc, 15); println();
    free(d);
}
