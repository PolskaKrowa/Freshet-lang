// fsht-01:01 corpus — while/break/continue, C-style for with a step,
// range loops with by-1 descending and by-3 striding.
fn main() {
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) { continue; }
        if (i == 8) { break; }
        acc = acc + i;
    }
    print_i64(acc); println();                // 25 (1+2+4+5+6+7)
    let mut t: i64 = 0;
    for (j = 0; j < 5; j += 2) { t = t + j; }
    print_i64(t); println();                  // 6  (0+2+4)
    let mut u: i64 = 0;
    for (k in 0..9 by 3) { u = u + k; }
    print_i64(u); println();                  // 9  (0+3+6)
    let mut dn: i64 = 0;
    for (k in 5..1 by -1) { dn = dn + k; }
    print_i64(dn); println();                 // 14 (5+4+3+2)
}
