// fsht-01:01 corpus — ownership modes (owned/borrowed), give at the call
// site, defer, and unsafe scopes.
fn consume(owned data: *u8) {
    free(data);
}
fn inspect(borrowed data: Span<f64>) -> f64 {
    let mut s: f64 = 0.0;
    for (i in 0..data.len) { s = s + data[i]; }
    return s;
}
@unsafe fn unsafe_helper(v: Span<i64>) -> i64 {
    return v[0] + v[1];
}
fn main() {
    let a: *f64 = malloc(f64, 3);
    a[0] = 1.0; a[1] = 2.0; a[2] = 3.0;
    print_f64(inspect(span(a, 3)), 1); println();   // 6.0
    free(a);
    let b: *u8 = malloc(u8, 16);
    consume(give(b));                                // ownership moves IN
    let c: *i64 = malloc(i64, 4);
    defer free(c);
    c[0] = 41;
    c[1] = c[0] + 1;
    print_i64(c[1]); println();                      // 42
    let arr: [i64; 2] = [5, 6];
    let v: Span<i64> = span(arr);
    unsafe {
        print_i64(v[0]); print(" "); print_i64(v[1]); println();   // 5 6
    }
    print_i64(unsafe_helper(span(arr))); println(); // 11
}
