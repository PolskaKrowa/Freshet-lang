// fsht-01:01 corpus — enums, tagged unions, contextual construction and
// exhaustive match with positional payload bindings.
enum Color { Red, Green, Blue }
enum Shape { Circle(f64), Rect(f64, f64), Point }
fn area(s: Shape) -> f64 {
    match (s) {
        Circle(r) => { return 3.0 * r * r; }
        Rect(w, h) => { return w * h; }
        Point => { return 0.0; }
    }
}
fn main() {
    let c: Color = Green;
    match (c) {
        Red => { print("red"); }
        Green => { print("green"); }
        Blue => { print("blue"); }
    }
    println();                                   // green
    print_f64(area(Circle(2.0)), 1); println();   // 12.0
    print_f64(area(Rect(2.5, 4.0)), 1); println(); // 10.0
    print_f64(area(Point), 1); println();          // 0.0
    let q: Shape = Rect(1.0, 1.0);
    let r: Shape = q;
    print_f64(area(r), 1); println();              // 1.0 (enums are values)
}
