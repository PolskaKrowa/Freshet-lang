// fsht-01:01 corpus — explicit casts and literal adoption (widening int of
// same signedness and f32->f64 are implicit; everything else is `as`).
fn main() {
    let a: i32 = 100;
    let b: i64 = a as i64;
    let c: u8 = 250;
    print_i64(b + c as i64); println();       // 350
    let x: f32 = 1.5;
    let y: f64 = x as f64;
    print_f64(y * 2.0, 2); println();         // 3.00
    let d: i64 = 7;
    let e: f64 = d as f64;
    print_f64(e, 1); println();              // 7.0
    print_i64(3.9 as i64); println();         // 3  (trunc toward zero)
}
