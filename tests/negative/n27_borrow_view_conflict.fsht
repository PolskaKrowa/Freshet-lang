// fsht-03:02: container growth against a live shared view — F0310.
// The view is used after vec_push, so it is live across the push;
// reallocation would dangle it (the shape was already undefined in
// earlier versions; fsht-03:02 diagnoses it).
fn main() {
    let mut v: Vec<i64> = vec_new(i64, 2);
    vec_push(&mut v, 1);
    vec_push(&mut v, 2);
    let view: Span<i64> = v[0..2];      // shared borrow, live below
    vec_push(&mut v, 3);                  // growth conflicts with the live view
    print_i64(view[1]); println();        // ...and the view is used again
}
